    "/api/copies": {
      "get": {
        "operationId": "CopiesController_page",
        "parameters": [
          {
            "name": "provider",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "gdrive",
                "gphotos",
                "onedrive"
              ]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "hash prefix or part of the remote path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skip",
            "required": false,
            "in": "query",
            "schema": {
              "default": 0,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          },
          {
            "name": "take",
            "required": false,
            "in": "query",
            "schema": {
              "default": 50,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CopyPageDto"
                }
              }
            }
          }
        },
        "tags": [
          "copies"
        ]
      }
    },
    "/api/copies/totals": {
