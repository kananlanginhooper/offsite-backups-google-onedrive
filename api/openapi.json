  "info": {
    "title": "Offsite backups",
    "description": "Track, save and restore offsite copies on Google Drive and OneDrive",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "LoginConfigDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "issuer": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "issuer",
          "clientId"
        ]
      },
      "UiConfigDto": {
        "type": "object",
        "properties": {
          "apiBase": {
            "type": "string",
            "example": "api"
          },
          "basePath": {
            "type": "string",
            "example": "/"
          },
          "publicUrl": {
            "type": "string"
          },
          "frameParents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "login": {
            "$ref": "#/components/schemas/LoginConfigDto"
          }
        },
        "required": [
          "apiBase",
          "basePath",
          "publicUrl",
          "frameParents",
          "login"
        ]
      },
      "SpaceDto": {
        "type": "object",
        "properties": {
          "takenAt": {
            "type": "string"
          },
          "totalBytes": {
            "type": "number",
            "nullable": true
          },
          "usedBytes": {
            "type": "number",
            "nullable": true
          },
          "freeBytes": {
            "type": "number",
            "nullable": true
          },
          "trashedBytes": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "takenAt",
          "totalBytes",
          "usedBytes",
          "freeBytes",
          "trashedBytes"
        ]
      },
      "SpaceErrorDto": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "why the check failed, in plain words"
          },
          "detail": {
            "type": "string",
            "description": "rclone's own last line"
          }
        },
        "required": [
          "at",
          "reason",
          "detail"
        ]
      },
      "ProviderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "gdrive",
              "onedrive"
            ]
          },
          "label": {
            "type": "string"
          },
          "remote": {
            "type": "string",
            "description": "rclone remote name; empty when not set up"
          },
          "space": {
            "nullable": true,
            "description": "latest space check",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SpaceDto"
              }
            ]
          },
          "lastError": {
            "nullable": true,
            "description": "the last space check, when it failed after the latest good one",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SpaceErrorDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "label",
          "remote",
          "space",
          "lastError"
        ]
      },
      "ConnectStartDto": {
        "type": "object",
        "properties": {
          "authUrl": {
            "type": "string",
            "description": "the provider's sign-in page; open it in a new tab"
          },
          "redirectUri": {
            "type": "string",
            "description": "where the provider sends the browser after approval (a page that will not load); its full address is pasted back"
          }
        },
        "required": [
          "authUrl",
          "redirectUri"
        ]
      },
      "ConnectFinishDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "the full address the browser landed on after approving"
          }
        },
        "required": [
          "url"
        ]
      },
      "ConnectResultDto": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "nullable": true,
            "description": "the account that signed in, when the provider says"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderDto"
          }
        },
        "required": [
          "account",
          "provider"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CopyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "hash": {
            "type": "string",
            "description": "sha256 of the content"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gdrive",
              "gphotos",
              "onedrive"
            ]
          },
          "remotePath": {
            "type": "string"
          },
          "size": {
            "type": "number",
            "nullable": true
          },
          "placedBy": {
            "type": "string"
          },
          "verifiedBy": {
            "type": "string"
          },
          "verifiedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "hash",
          "provider",
          "remotePath",
          "size",
          "placedBy",
          "verifiedBy",
          "verifiedAt"
        ]
      },
      "CopyPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CopyDto"
            }
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "ProviderTotalsDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "gdrive",
              "gphotos",
              "onedrive"
            ]
          },
          "files": {
            "type": "number"
          },
          "bytes": {
            "type": "number"
          },
          "lastVerifiedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "provider",
          "files",
          "bytes",
          "lastVerifiedAt"
        ]
      },
      "DailyTotalsDto": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "example": "2026-10-28"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gdrive",
              "gphotos",
              "onedrive"
            ]
          },
          "files": {
            "type": "number"
          },
          "bytes": {
            "type": "number"
          }
        },
        "required": [
          "day",
          "provider",
          "files",
          "bytes"
        ]
      },
      "RestoreDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gdrive",
              "gphotos",
              "onedrive"
            ]
          },
          "hash": {
            "type": "string",
            "nullable": true
          },
          "remotePath": {
            "type": "string"
          },
          "destination": {
            "type": "string",
            "description": "where the file lands on the server"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "requestedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string",
            "nullable": true
          },
          "bytes": {
            "type": "number",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "provider",
          "hash",
          "remotePath",
          "destination",
          "status",
          "requestedAt",
          "finishedAt",
          "bytes",
          "error"
        ]
      },
      "CreateRestoreDto": {
        "type": "object",
        "properties": {
          "copyId": {
            "type": "number",
            "description": "id of the offsite copy to bring back"
          }
        },
        "required": [
          "copyId"
        ]
      },
      "JobRunDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gdrive",
              "gphotos",
              "onedrive"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "push",
              "restore",
              "verify",
              "space"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "startedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string",
            "nullable": true
          },
          "filesTotal": {
            "type": "number",
            "nullable": true
          },
          "filesDone": {
            "type": "number"
          },
          "bytesTotal": {
            "type": "number",
            "nullable": true
          },
          "bytesDone": {
            "type": "number"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "provider",
          "kind",
          "status",
          "startedAt",
          "finishedAt",
          "filesTotal",
          "filesDone",
          "bytesTotal",
          "bytesDone",
          "message"
        ]
      }
    }
  }
}
