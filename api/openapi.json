          "providers"
        ]
      },
      "get": {
        "operationId": "ProvidersController_spaceHistory",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "gdrive",
                "onedrive"
              ],
              "type": "string"
            }
          },
          {
            "name": "days",
            "required": true,
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
