# Copy to .env (gitignored) and fill in. Placeholders only here.
PORT=8101
# address the container port is published on (IPv4 only); the server sets its LAN address
BIND_ADDR=127.0.0.1
PUBLIC_URL=http://<host>:8101          # later https://<app>.<domain>
UI_BASE_PATH=/
UI_DIST=/app/ui                        # where the built UI is inside the container
FRAME_ANCESTORS=http://localhost:8097 http://<server LAN address>:8097   # every Home dashboards origin
FORWARDED_ALLOW_IPS=127.0.0.1
LOGIN=off                              # on once the IdP is live
OIDC_ISSUER=<IdP public URL>
OIDC_CLIENT_ID=<this app's client id>

# This app's own database (Postgres)
DB_HOST=<db host>
DB_PORT=5432
DB_NAME=<project db>
DB_USER=<project user>
DB_PASSWORD=<generated, never committed>

# Shared catalogue database (MySQL), read-only
RECOVERY_DB_HOST=<db host>
RECOVERY_DB_PORT=3306
RECOVERY_DB_NAME=<catalogue db>
RECOVERY_DB_USER=<project user>
RECOVERY_DB_PASSWORD=<generated, never committed>

# rclone: remote names come from rclone.conf, mounted into the container
RCLONE_CONFIG=/config/rclone/rclone.conf
RCLONE_CONFIG_DIR=<host folder that holds rclone.conf>
GDRIVE_REMOTE=<google drive remote>:   # rclone remote name; the trailing colon is optional
ONEDRIVE_REMOTE=<onedrive remote>:
RESTORE_ROOT=/restores
RESTORE_HOST_DIR=<host folder restores land in>

# Pushers (pusher/): which files go where. Library-specific values stay in .env only.
RECOVERY_DB_CNF=                       # optional MySQL option file instead of host/user/password
PUSH_INVENTORY_TABLE=<inventory table> # hash, dest_path, src_root, rel_path, kind
PUSH_INTAKE_ROOTS=<root1/> <root2/>    # only files under these local roots are pushed
PUSH_DEPRIORITIZED_PREFIX=             # a hash's copy under this prefix is picked last
PUSH_OWNER_TAG=<decided_by value for the owner's own decisions>
PUSH_TAKEOUT_PART_PATTERNS=<takeout part LIKE pattern> <another>
PUSH_TAKEOUT_PARTS=<expected part count>
PUSH_BATCHES_FILE=<path to batches.json, shaped like pusher/batches.example.json>
PUSH_GDRIVE_QUEUE="batch:documents;project:<project name>;batch:video"
PUSH_JOB_LOCK_DIR=<job lock folder>
PUSH_JOB_OWNER_PATTERN=<regex the lock owner must match>
PUSH_BWLIMIT=40M
ONEDRIVE_PUSH_BWLIMIT=
GDRIVE_ACCOUNT=<account label recorded with each copy>
GDRIVE_BASE=<folder on the remote>
ONEDRIVE_ACCOUNT=<account label recorded with each copy>
ONEDRIVE_BASE=<folder on the remote>
# the standalone CLIs that move the files: pip install from the GoogleDriveRclone / OneDriveRclone repos
GDRIVE_CLI=gdrive-rclone               # or a full command, e.g. python3 <path>/gdrive_rclone.py
ONEDRIVE_CLI=onedrive-rclone
