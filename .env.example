# Copy to .env (gitignored) and fill in. Placeholders only here.
PORT=8101                              # port the API + UI listen on (inside and outside the container)
BIND_ADDR=127.0.0.1                    # IPv4 address the port is published on; the server sets its LAN address
PUBLIC_URL=http://<host>:8101          # address people open; later https://<app>.<domain>
UI_BASE_PATH=/                         # path the UI is served under (sets <base href>)
UI_DIST=/app/ui                        # where the built UI is inside the container
FRAME_ANCESTORS=http://localhost:8097 http://<server LAN address>:8097   # every Home dashboards origin
FORWARDED_ALLOW_IPS=127.0.0.1          # proxies whose X-Forwarded-* headers are trusted
LOGIN=off                              # on once the IdP is live
OIDC_ISSUER=<IdP public URL>           # the sign-in server, used when LOGIN=on
OIDC_CLIENT_ID=<this app's client id>  # this app's client registered with the IdP

# This app's own database (Postgres)
DB_HOST=<db host>                      # Postgres host
DB_PORT=5432                           # Postgres port
DB_NAME=<project db>                   # this app's database
DB_USER=<project user>                 # this app's login
DB_PASSWORD=<generated, never committed>   # that login's password

# Shared catalogue database (MySQL), read-only
RECOVERY_DB_HOST=<db host>             # MySQL host
RECOVERY_DB_PORT=3306                  # MySQL port
RECOVERY_DB_NAME=<catalogue db>        # the catalogue database
RECOVERY_DB_USER=<project user>        # read-only login (SELECT only)
RECOVERY_DB_PASSWORD=<generated, never committed>   # that login's password

# rclone: remote names come from rclone.conf, mounted into the container
RCLONE_CONFIG=/config/rclone/rclone.conf   # rclone.conf path inside the container
RCLONE_CONFIG_DIR=<host folder that holds rclone.conf>   # mounted read-only at /config/rclone
GDRIVE_REMOTE=<google drive remote>:   # rclone remote name; the trailing colon is optional
ONEDRIVE_REMOTE=<onedrive remote>:     # rclone remote name; the trailing colon is optional
RESTORE_ROOT=/restores                 # where restores are written inside the container
RESTORE_HOST_DIR=<host folder restores land in>   # mounted at RESTORE_ROOT

# Pushers (pusher/): which files go where. Library-specific values stay in .env only.
RECOVERY_DB_CNF=                       # optional MySQL option file instead of host/user/password
PUSH_INVENTORY_TABLE=<inventory table> # hash, dest_path, src_root, rel_path, kind
PUSH_INTAKE_ROOTS=<root1/> <root2/>    # only files under these local roots are pushed
PUSH_DEPRIORITIZED_PREFIX=             # a hash's copy under this prefix is picked last
PUSH_OWNER_TAG=<decided_by value for the owner's own decisions>   # marks the owner's own review decisions
PUSH_TAKEOUT_PART_PATTERNS=<takeout part LIKE pattern> <another>  # Takeout parts that must be indexed first
PUSH_TAKEOUT_PARTS=<expected part count>   # how many of those parts must be done before anything uploads
PUSH_BATCHES_FILE=<path to batches.json, shaped like pusher/batches.example.json>   # batch definitions, kept out of git
PUSH_GDRIVE_QUEUE="batch:documents;project:<project name>;batch:video"   # Google queue order, ;-separated
PUSH_JOB_LOCK_DIR=<job lock folder>    # folder of <job>/owner lock files
PUSH_JOB_OWNER_PATTERN=<regex the lock owner must match>   # a push starts only when this runner holds the lock
PUSH_BWLIMIT=40M                       # Google upload bandwidth limit (rclone --bwlimit)
ONEDRIVE_PUSH_BWLIMIT=                 # OneDrive upload bandwidth limit; empty = none
GDRIVE_ACCOUNT=<account label recorded with each copy>     # offsite_copy.account for Google
GDRIVE_BASE=<folder on the remote>     # Google folder the copies go under
ONEDRIVE_ACCOUNT=<account label recorded with each copy>   # offsite_copy.account for OneDrive
ONEDRIVE_BASE=<folder on the remote>   # OneDrive folder the copies go under
GDRIVE_CLI=gdrive-rclone               # the standalone Google CLI (GoogleDriveRclone repo), or e.g. python3 <path>/gdrive_rclone.py
ONEDRIVE_CLI=onedrive-rclone           # the standalone OneDrive CLI (OneDriveRclone repo)
