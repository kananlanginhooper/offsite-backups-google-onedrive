# Copy to .env (gitignored) and fill in. Placeholders only here.
PORT=8101
PUBLIC_URL=http://<host>:8101          # later https://<app>.<domain>
UI_BASE_PATH=/
UI_DIST=/app/ui                        # where the built UI is inside the container
FRAME_ANCESTORS=http://localhost:8097 http://<server LAN address>:8097   # every Home dashboards origin
FORWARDED_ALLOW_IPS=127.0.0.1
LOGIN=off                              # on once the IdP is live
OIDC_ISSUER=<IdP public URL>
OIDC_CLIENT_ID=<this app's client id>

# This app's own database (Postgres)
DB_HOST=<db host>
DB_PORT=5432
DB_NAME=<project db>
DB_USER=<project user>
DB_PASSWORD=<generated, never committed>

# Shared catalogue database (MySQL), read-only
RECOVERY_DB_HOST=<db host>
RECOVERY_DB_PORT=3306
RECOVERY_DB_NAME=<catalogue db>
RECOVERY_DB_USER=<project user>
RECOVERY_DB_PASSWORD=<generated, never committed>

# rclone: remote names come from rclone.conf, mounted into the container
RCLONE_CONFIG=/config/rclone/rclone.conf
RCLONE_CONFIG_DIR=<host folder that holds rclone.conf>
GDRIVE_REMOTE=<google drive remote name>
ONEDRIVE_REMOTE=<onedrive remote name>
RESTORE_ROOT=/restores
RESTORE_HOST_DIR=<host folder restores land in>
